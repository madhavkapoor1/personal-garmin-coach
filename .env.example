# Copy this file to `.env` and fill in your values.
# Only the email is needed here. The password is entered interactively ONCE
# during `python scripts/bootstrap_login.py` and never stored in this file.

GARMIN_EMAIL=you@example.com

# Optional: your personal HR markers (used by the dashboard & analytics).
# Zone 2 ceiling = top of true "easy". LTHR = lactate-threshold HR. MAX = max HR.
HR_ZONE2_CEILING=150
HR_LTHR=170
HR_MAX=190

# Optional overrides (sensible defaults exist in config.py)
# GARMIN_TOKENSTORE=~/.garminconnect
# TIMEZONE=Europe/London
